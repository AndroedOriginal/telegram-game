# Telegram bot token from @BotFather. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token

# The chat where Chess Royale is allowed to run (numeric chat id, can be
# negative for groups/supergroups). Leave empty to allow any chat.
TELEGRAM_CHAT_ID=

# The forum topic ("Chess Royale") message_thread_id inside that chat.
# Leave empty to use the chat's General topic / non-forum chats.
TELEGRAM_TOPIC_ID=

# Optional: pin Buckshot Roulette to a specific forum topic id.
# Leave empty to allow /buckshot in any topic of the allowed chat.
BUCKSHOT_TOPIC_ID=

# Path to the SQLite database file used for persistence.
DATABASE_PATH=chess_royale.sqlite3
